# Copy to .env and fill in. .env is gitignored.

# Matches docker-compose.yml. Use 127.0.0.1 (not localhost) on Windows/Docker
# Desktop so it resolves to IPv4 — the container only maps the IPv4 port.
DATABASE_URL=postgresql://agenda:agenda@127.0.0.1:5432/agenda

# Public base URL (used for RSS feeds, sitemap, robots.txt)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Auth.js — generate with: npx auth secret  (or: openssl rand -base64 32)
AUTH_SECRET=replace-me

# Google OAuth — create at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Email (OTP codes + agenda alerts). The app relays to an SMTP server that
# handles DKIM signing and delivery. In the Docker deploy, "mailhost" resolves
# to the host gateway, where Postfix + opendkim run; for local dev point it at
# any SMTP server (e.g. MailHog on 127.0.0.1:1025). Empty SMTP_HOST => no email.
SMTP_HOST=mailhost
SMTP_PORT=25
MAIL_FROM=agenda.delivery <update@agenda.delivery>

# Text/SMS is off until a sender (e.g. Twilio) is wired into notify.py + otp.ts.
SMS_ENABLED=false

# ── Phase 4: Agent system ──────────────────────────────────
# Ollama cloud (or any OpenAI-compatible /v1/chat/completions endpoint).
# Leave empty in development to use the built-in deterministic mock.
OLLAMA_BASE_URL=
OLLAMA_API_KEY=

# Models — glm-5.3 for agent reasoning/tool-use, gemma4 for summaries.
AGENT_MODEL=glm-5.3
SUMMARY_MODEL=gemma4:31b

# Where the Escalation Agent sends failures that need a human.
ADMIN_EMAIL=jameshansen.bc@gmail.com
# How often it sweeps (seconds). Also editable per-agent in the admin panel.
ESCALATION_INTERVAL_SECS=900

# Used for unsubscribe links in mailing-list sends.
BASE_URL=https://agenda.delivery
