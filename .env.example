# Copy to .env and fill in. .env is gitignored.

# Matches docker-compose.yml. Use 127.0.0.1 (not localhost) on Windows/Docker
# Desktop so it resolves to IPv4 — the container only maps the IPv4 port.
DATABASE_URL=postgresql://agenda:agenda@127.0.0.1:5432/agenda

# Public base URL (used for RSS feeds, sitemap, robots.txt)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Auth.js — generate with: npx auth secret  (or: openssl rand -base64 32)
AUTH_SECRET=replace-me

# Google OAuth — create at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ── Phase 4: Agent system ──────────────────────────────────
# Ollama cloud (or any OpenAI-compatible /v1/chat/completions endpoint).
# Leave empty in development to use the built-in deterministic mock.
OLLAMA_BASE_URL=
OLLAMA_API_KEY=

# Models — glm-5.2 for agent reasoning/tool-use, gemma4 for summaries.
AGENT_MODEL=glm-5.2
SUMMARY_MODEL=gemma4:31b
